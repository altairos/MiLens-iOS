        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App lädt deine Fotos niemals hoch; bearbeitete Werke können durch von dir aktivierte System-Backups gespeichert werden."
          }
        },
        "en" : {
          "stringUnit" : {
