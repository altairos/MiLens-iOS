          }
        }
      }
    },
    "paywall.terms.trial" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d Tage kostenlos, danach automatische Verlängerung für %2$@. Jederzeit in den App-Store-Accounteinstellungen kündbar; der aktuelle Abrechnungszeitraum bleibt bestehen."
