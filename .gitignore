# Xcode / Swift 生成产物
DerivedData/
build/
*.build/
.build/

# XcodeGen 生成的工程文件（每次 xcodegen generate 重建）
*.xcodeproj/
*.xcworkspace/

# 用户数据
*.xcuserstate
xcuserdata/
*.xcuserdatad/
*.swp
*.lock

# 签名与证书（永不提交）
*.p12
*.cer
*.mobileprovision
*.pem
Signing*.xcconfig

# 本机配置（含绝对路径/密码）
*.local.xcconfig
.env
.env.*

# Swift Package Manager 解析缓存
.swiftpm/
Package.resolved

# macOS
.DS_Store

# 模型与媒体（大文件，按需单独管理）
# .mlpackage 由 tools/convert_*_coreml.py 在 macOS 上生成，不提交。
# pet_text_embeddings.f32（40 KB）除外，已提交到 Resources/Models/。
*.mlpackage
*.mlmodel
*.coreml
*.mlmodelc

# 模型转换工具链临时产物
.venv-models/
*_traced.pt
*.onnx

# 临时与备份
*.tmp
*~
tmp/

# Python 生成产物（模型转换工具链）
__pycache__/
*.pyc
*.pyo

*.disabled

# 字体子集化临时工作目录
.tmp-fonts/
