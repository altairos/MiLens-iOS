        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez des photos de %@ uniquement, sous différents angles. Toute la reconnaissance s'exécute localement sur votre appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鮮明で、角度が異なり、%@だけが写っている写真を選んでください。\n処理はすべて端末上で行います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择清晰、角度不同、只包含%@的照片；\n所有处理都在本机完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
