    "widget.lifeArchive.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how long you have been together, plus recent photos and memories"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez depuis combien de temps vous êtes ensemble, ainsi que vos photos et souvenirs récents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份档案已经积累了多久、多少照片和多少记忆"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄你們相伴了多久，以及近期的照片與珍貴回憶"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie lange ihr schon zusammen seid, plus aktuelle Fotos und Erinnerungen"
          }
        }
      }
    },
