    "privacy.storage.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importierte Fotokopien und Profildaten werden in der App-Sandbox gespeichert. Durch das Löschen der App werden diese Daten entfernt; Originale in deiner System-Fotomediathek bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imported photo copies and profile data are stored in the app sandbox. Deleting the app removes this data; originals in your system photo library are unaffected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies importées et les profils sont stockés dans l'espace local de l'app. Supprimer l'app efface ces données, sans toucher aux originaux de votre photothèque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込んだ写真のコピーとプロフィールデータは、App内に保存されます。Appを削除するとこれらのデータも削除されますが、「写真」アプリの元の写真には影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入的照片副本与档案数据保存在 App 沙盒内。删除 App 会一并删除这些数据；系统相册中的原图不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入的照片副本與檔案資料儲存在 App 沙盒內。刪除 App 會一併移除這些資料；系統相簿中的原始照片不受任何影響。"
          }
        }
      }
    },
