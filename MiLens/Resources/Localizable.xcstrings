            "value" : "%1$d Tage gratis, danach %2$@. Jederzeit in den App Store Account Einstellungen kündbar; der aktuelle Zeitraum bleibt gültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free for %1$d days, then renews at %2$@. Cancel anytime in App Store Account Settings; your current period remains valid after cancellation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essai gratuit pendant %1$d jours, puis renouvellement au tarif de %2$@. Annulation possible à tout moment dans les Réglages App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费试用 %1$d 天，之后按 %2$@ 自动续费。可随时在 App Store 账户设置中取消，取消后当前已生效周期不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費試用 %1$d 天，之後按 %2$@ 自動續訂。可隨時在 App Store 帳號設定中取消，取消後當前已生效週期不受影響。"
          }
        }
      }
    },
