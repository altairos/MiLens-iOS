    "help.a1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens scans your photo library on device using local AI models to discover photos featuring your pal, then lets you confirm matches."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相册页使用「扫描」，咪Lens 会在本机找出可能含宠物的照片，确认后导入。"
          }
        }
      }
    },
    "help.a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. All photo analysis, categorization, and editing run 100% locally on your device. Your photos never leave your phone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描确认时选择宠物即可；相册里也可以多选照片后归档到指定宠物。"
          }
        }
      }
    },
    "help.a3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to the Create tab, select Bead Pattern, pick a photo of your pal, choose pegboard size and palette, then tap Generate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在创作 Tab 选择「拼豆图纸」，挑一张照片，调整尺寸与风格后即可生成并导出。"
          }
        }
      }
    },
    "help.a4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens Pro unlocks up to 20 pal profiles, unlimited bead pattern generation, full lifetime growth timeline, and watermark-free exports."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拼豆图纸可以保存到系统相册，也可以通过系统分享发送给他人。"
          }
        }
      }
    },
