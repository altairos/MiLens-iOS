        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens needs permission to save bead patterns, pal cards, and timeline export images to your Photos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens 需要保存导出的拼豆图纸和照片到相册。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens needs access to your photo library to discover photos of your pal and create local profiles. Photos are never uploaded; edited works may be saved by system backups you have enabled."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens 需要访问相册来发现和整理你的宠物照片。所有分析在本地完成。App 不会主动上传照片；编辑产物可能随用户启用的系统备份保存。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
