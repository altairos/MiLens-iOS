    "settings.backup.photoBackupMode.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren spart iCloud-Speicher; Originale bleiben in „Fotos“. Aktiviert werden importierte Kopien im System-Backup gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off to save iCloud storage (originals can be rebuilt from Photos). When on, imported copies are included in system backups."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez pour économiser de l'espace iCloud. Les originaux restent dans Photos ; sinon, les copies importées suivent la sauvegarde système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudストレージ容量を節約するにはオフにします （元の画像は「写真」アプリから再構築できます）。オンにすると、インポートされたコピーがシステムバックアップとともに保存されるため、データの安全性が高まります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
