    "privacy.commit.gdpr.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotoerkennung und Merkmalsextraktion finden vollständig auf deinem Gerät statt. Wir nutzen keine Cloud-Dienste und laden deine Fotos auf keine externen Server hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo recognition and feature extraction happen entirely on your device. We do not use cloud services or upload your photos to any external servers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance faciale et l'analyse s'exécutent entièrement en local sur votre appareil. Aucun cloud ni serveur externe n'est utilisé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有照片的识别与分析都在设备本地完成，不经过任何云服务，不连接任何外部服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有照片的辨識與特徵分析均在本機完成，不經過任何雲端服務，亦不連接任何外部伺服器。"
          }
        }
      }
    },
