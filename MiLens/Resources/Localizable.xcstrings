    "quota.locked.sheet.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose Plan zeigt die letzten 50 Fotos; ältere sind gesperrt. Abonniere Pro oder lösche Fotos, um Platz zu schaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free plan displays your 50 most recent photos; older photos are locked. Subscribe to restore full access, or delete extra photos to free up space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version gratuite affiche les 50 photos les plus récentes ; les autres sont verrouillées. Passez à Pro ou libérez de l'espace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料版では、古い写真はロックされた状態で、最新の50枚の写真を表示できます。更新してフルアクセスを復元するか、余分な写真を削除してストレージスペースを解放します。"
