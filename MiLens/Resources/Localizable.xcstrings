    "settings.backup.hint.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag mit deinem Liebling zählt. Exportiere regelmäßig eine .milensbackup-Datei nach iCloud Drive oder auf deinen Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with your pal is worth keeping whole. Use Backup Export regularly to create a .milensbackup file, save it to iCloud Drive, or AirDrop it to your computer — one more layer of protection for precious memories."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour avec votre compagnon compte. Exportez régulièrement un fichier .milensbackup vers iCloud Drive ou votre ordinateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うちの子との大切な日々を守るため、定期的にバックアップを書き出し、iCloud DriveやAirDropで安全な場所に保存することをおすすめします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和小伙伴的每一天都值得被完整留住。建议定期使用「备份导出」生成 .milensbackup 文件，保存到 iCloud 云盘或隔空投送到电脑，让珍贵的记忆多一份守护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和毛小孩的每一天都值得完整保留。建議定期使用「備份匯出」產生 .milensbackup 檔案，儲存到 iCloud Drive，或透過 AirDrop 傳送到電腦，為珍貴回憶多添一層守護。"
          }
        }
      }
    },
