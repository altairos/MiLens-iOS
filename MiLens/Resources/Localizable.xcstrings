    "onboarding.createArchive.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib zuerst Name und Tierart ein;\ndeine Mediathek wird noch nicht gescannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a profile for your pal first,\nthen scan your library anytime."
