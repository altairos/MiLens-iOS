    "recovery.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gab ein Problem beim Öffnen lokaler Einträge. Du kannst es erneut versuchen oder die lokalen Daten neu aufbauen: Das löscht MiLens-Einträge und Sandbox-Fotokopien. Originale in deiner System-Mediathek bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There was a problem opening local records. You can retry, or rebuild local data: this clears MiLens records and sandbox photo copies. Originals in your system library are unaffected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu lors de l'ouverture des données locales. Vous pouvez réessayer ou reconstruire la base : cela effacera les registres MiLens et les copies locales sans toucher à votre photothèque système."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开本地相册记录时出现问题。您可以重试，或重建本地数据：清除 MiLens 记录，同时也会删除沙盒中已保存的照片副本（导入/编辑产物）。系统相册中的原图不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟本機相簿記錄時出現問題。您可以重試，或重建本機資料：清除 MiLens 記錄，同時也會刪除沙盒中已儲存的照片副本（匯入／編輯產物）。系統相簿中的原圖不受影響。"
          }
        }
      }
    },
