    "settings.backup.exportReadyHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Speicherort: Dateien, iCloud Drive oder AirDrop auf deinen Computer. Bewahre dieses Backup gut auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose where to save it: the Files app, iCloud Drive, or AirDrop to your computer. Keep this memory safe so the story is always with you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez où l'enregistrer : Fichiers, iCloud Drive ou AirDrop. Gardez cette sauvegarde en lieu sûr pour préserver votre histoire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存先を選んでください：「ファイル」App、iCloud Drive、またはAirDrop。大切な思い出を安全な場所に保管しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择保存位置：文件 App、iCloud 云盘或隔空投送到电脑。把这份记忆好好保存，让温暖的故事无论何时都在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇儲存位置：檔案 App、iCloud Drive，或透過 AirDrop 傳送到電腦。好好保存這份備份，讓溫暖的故事一直都在。"
          }
        }
      }
    },
