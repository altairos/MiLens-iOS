    "help.a1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap \"Scan\" on the album page — MiLens finds photos that may contain your pal on your device, then lets you confirm and import them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相册页使用「扫描」，咪Lens 会在本机找出可能含宠物的照片，确认后导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相簿頁使用「掃描」，咪Lens 會在本機找出可能包含毛孩的照片，確認後匯入。"
          }
        }
      }
    },
    "help.a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a pal when reviewing scan results; you can also select multiple photos in the album and assign them to a pal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描确认时选择宠物即可；相册里也可以多选照片后归档到指定宠物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描確認時選擇毛孩即可；相簿裡也可以多選照片後歸檔到指定毛孩。"
          }
        }
      }
    },
    "help.a3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to the Create tab, choose \"Bead Pattern\", pick a photo, adjust size and style, then generate and export."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在创作 Tab 选择「拼豆图纸」，挑一张照片，调整尺寸与风格后即可生成并导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在創作分頁選擇「拼豆圖稿」，挑一張照片，調整尺寸與風格後即可產生並匯出。"
          }
        }
      }
    },
    "help.a4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bead patterns can be saved to your photo library or shared with others via the system share sheet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拼豆图纸可以保存到系统相册，也可以通过系统分享发送给他人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拼豆圖稿可以儲存到系統相簿，也可以透過系統分享傳送給他人。"
          }
        }
      }
    },
