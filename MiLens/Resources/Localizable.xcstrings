    "onboarding.import.keep.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder gemeinsame Tag ist es wert, in Erinnerung zu bleiben. MiLens organisiert deine verstreuten Momente in einem liebevollen digitalen Archiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day together is worth remembering. MiLens organizes your scattered moments into a dedicated digital archive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour partagé mérite d'être conservé. MiLens rassemble vos précieux moments dans une archive dédiée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和小伙伴的每一天都值得被完整记住。MiLens 可以把这些日子打包成一份专属的备份文件，无论时光怎样流转，温暖的瞬间都不会走散。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和毛小孩的每一天都值得被完整記住。MiLens 可以把這些日子打包成一份專屬的備份檔案，無論時光如何流轉，溫暖的瞬間都不會走散。"
          }
        }
      }
    },
