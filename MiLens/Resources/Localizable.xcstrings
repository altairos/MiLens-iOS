    "onboarding.import.keep.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder gemeinsame Tag verdient es, bewahrt zu werden. MiLens sichert eure Geschichte in einer eigenen Backup-Datei, damit kein schöner Moment verloren geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day you share with your pal deserves to be remembered in full. MiLens can pack those days into a dedicated backup file, so no warm moment gets lost as time goes by."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour partagé mérite d'être conservé. MiLens peut rassembler votre histoire dans un fichier de sauvegarde dédié, pour ne perdre aucun moment précieux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うちの子と過ごす毎日は、かけがえのない思い出です。MiLensなら、その日々を専用のバックアップとしてまとめて残せます。大切な時間を、これからもずっとそばに。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和小伙伴的每一天都值得被完整记住。MiLens 可以把这些日子打包成一份专属的备份文件，无论时光怎样流转，温暖的瞬间都不会走散。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和毛小孩的每一天都值得被完整記住。MiLens 可以把這些日子打包成一份專屬的備份檔案，無論時光如何流轉，溫暖的瞬間都不會走散。"
          }
        }
      }
    },
