    "help.a1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Scannen“ – MiLens sucht auf deinem Gerät nach möglichen Haustierfotos. Bestätige sie zum Import."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Scan” on the Photos page — MiLens finds photos that may contain your pal on your device, then lets you confirm and import them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Photos, touchez « Analyser ». MiLens recherche sur cet appareil les photos de votre compagnon ; confirmez ensuite celles à importer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムページで [スキャン] を使用すると、MiLensがパートナーが含まれている可能性のある写真を見つけて確認し、インポートします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相册页使用「扫描」，咪Lens 会在本机找出可能含伙伴的照片，确认后导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相簿頁使用「掃描」，咪Lens 會在本機找出可能包含毛小孩的照片，確認後匯入。"
          }
        }
      }
    },
    "help.a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle beim Prüfen der Scan-Ergebnisse ein Haustier aus. In „Fotos“ kannst du außerdem mehrere Bilder auswählen und gemeinsam zuordnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a pal when reviewing scan results; you can also select multiple photos in Photos and assign them to a pal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un compagnon lors de la confirmation ; vous pouvez également sélectionner plusieurs photos dans l'album et les assigner en une seule fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認のためにスキャンするときにパートナーを選択するだけです。アルバム内の複数の写真を選択して、指定したパートナーにアーカイブすることもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描确认时选择伙伴即可；相册里也可以多选照片后归档到指定伙伴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描確認時選擇毛小孩即可；相簿裡也可以多選照片後歸檔到指定毛小孩。"
          }
        }
      }
    },
    "help.a3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe zum Tab Erstellen, wähle „Bügelperlen-Muster“, nimm ein Foto, passe Größe und Stil an, erstelle es und exportiere es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to the Create tab, choose “Bead Pattern”, pick a photo, adjust size and style, then generate and export."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendez-vous dans l'onglet Atelier, choisissez « Modèle de perles », sélectionnez une photo, réglez la taille et le style, puis exportez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作成タブの「豆の描画」を選択し、写真を選択し、サイズやスタイルを調整して生成し、エクスポートします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在创作 Tab 选择「拼豆图纸」，挑一张照片，调整尺寸与风格后即可生成并导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在創作分頁選擇「拼豆圖稿」，挑一張照片，調整尺寸與風格後即可產生並匯出。"
          }
        }
      }
    },
    "help.a4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bügelperlen-Muster können in deiner Fotomediathek gespeichert oder über die Systemfreigabe mit anderen geteilt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bead patterns can be saved to your photo library or shared with others via the system share sheet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles de perles peuvent être enregistrés dans votre photothèque ou partagés directement via le menu de partage système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイロンビーズの図案は「写真」アプリに保存したり、共有機能でほかの人に送ったりできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拼豆图纸可以保存到系统相册，也可以通过系统分享发送给他人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拼豆圖稿可以儲存到系統相簿，也可以透過系統分享傳送給他人。"
          }
        }
      }
    },
