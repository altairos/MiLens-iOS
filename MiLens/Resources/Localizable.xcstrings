    "paywall.terms.subscription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch für %@. Kann jederzeit in den App Store-Accounteinstellungen gekündigt werden; dein aktueller Zeitraum bleibt nach der Kündigung gültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renews automatically at %@. Cancel anytime in App Store Account Settings; your current period remains valid after cancellation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique au tarif de %@. Annulation possible à tout moment dans les réglages du compte App Store ; la période en cours reste acquise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を押して自動的に更新します。App Storeのアカウント設定でいつでもキャンセルできます。キャンセル後も現在の有効期間は影響を受けません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 %@ 自动续费，可随时在 App Store 账户设置中取消，取消后当前已生效周期不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
