    "settings.backup.hint.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups werden offline gespeichert. Du kannst Backup-Dateien über AirDrop, Dateien oder Cloud-Laufwerke übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups are stored offline. You can transfer backup files via AirDrop, Files, or cloud drives."
          }
