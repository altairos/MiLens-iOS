    "pet.profile.continuity.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom ersten Foto und ersten Ausflug bis zu den kleinen Veränderungen jeden Tag – jeder Moment kehrt dorthin zurück, wo er passiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From the first photo and first outing to the little changes each day, every moment returns to when it happened."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la première photo à la première sortie, jusqu'aux petits changements du quotidien : chaque fragment retrouve le moment où il a eu lieu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の写真、初めての外出、毎日の小さな変化まで。すべての断片はそれが起こった時間に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从第一张照片、第一次出门，到每天微小的变化；所有片段都回到它发生的时间里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從第一張照片、第一次出門，到每天微小的變化；所有片段都回到它發生的時間裡。"
          }
        }
      }
    },
    "pet.profile.continuity.headline" : {
