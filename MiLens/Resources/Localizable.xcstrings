    "onboarding.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens liest Fotos nur innerhalb deines autorisierten Bereichs.\nNichts wird importiert, bis du es bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens only reads photos within your authorized scope.\nNothing is imported until you confirm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens lit uniquement les photos locales auxquelles vous avez donné accès.\nVous confirmez toujours ce qui sera importé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLensが読み取るのは、アクセスを許可した端末内の写真だけです。\n実際に取り込む写真は、必ずご自身で確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「咪Lens」只读取访问范围内的本地照片，\n最终导入什么，始终由你确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「咪Lens」僅在你授權的範圍內讀取裝置上的照片，\n最終匯入哪些照片，始終由你親自確認。"
          }
        }
      }
