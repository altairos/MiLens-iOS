    "recovery.rebuildConfirmBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Albumeinträge, Haustierprofile und Sandbox-Fotokopien gelöscht. Diese Aktion kann nicht rückgängig gemacht werden. Originale bleiben in deiner Fotomediathek erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear album records, pal profiles, and sandbox photo copies in MiLens. This action cannot be undone. Originals in your system photo library are unaffected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action réinitialisera les albums, profils et copies locales dans MiLens. Cette opération est irréversible. Vos photos d'origine dans la photothèque restent intactes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将清除 MiLens 中的相册记录、伙伴档案及沙盒中已保存的照片副本（导入/编辑产物），且无法恢复。系统相册中的原图不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將清除 MiLens 中的相簿記錄、毛小孩檔案及沙盒中已儲存的照片副本（匯入/編輯產物），且無法回復。系統相簿中的原圖不會被刪除。"
          }
        }
      }
    },
