      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch für %@. Kann jederzeit in den App Store-Accounteinstellungen gekündigt werden; dein aktueller Zeitraum bleibt nach der Kündigung gültig."
          }
        },
