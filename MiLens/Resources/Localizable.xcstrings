    "settings.backup.hint.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag mit deinem Liebling zählt. Exportiere regelmäßig eine .milensbackup-Datei nach iCloud Drive oder auf deinen Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with your pal is worth keeping. Export a .milensbackup file regularly, then save it to iCloud Drive or AirDrop it to your computer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour avec votre compagnon compte. Exportez régulièrement un fichier .milensbackup vers iCloud Drive ou votre ordinateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたと友達が一緒に過ごす毎日は、そのままにしておく価値があります。貴重な思い出を保護するために、定期的に「バックアップエクスポート」を使用して .milensbackupファイルを生成し、それらをiCloudディスクに保存するか、コンピュータにエアドロップすることをお勧めします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和小伙伴的每一天都值得被完整留住。建议定期使用「备份导出」生成 .milensbackup 文件，保存到 iCloud 云盘或隔空投送到电脑，让珍贵的记忆多一份守护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和毛小孩的每一天都值得完整保留。建議定期使用「備份匯出」產生 .milensbackup 檔案，儲存到 iCloud Drive，或透過 AirDrop 傳送到電腦，為珍貴回憶多添一層守護。"
          }
        }
      }
    },
