    "pet.profile.unassignedHintBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importierte oder gescannte Fotos ohne Haustierzuordnung erscheinen hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos imported or scanned in the album that aren't assigned to a pal appear here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l'import ou l'analyse de photos, celles qui ne sont pas encore attribuées à un compagnon apparaissent ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバム内の写真をインポートまたはスキャンした後、パートナーがまだ所有していない写真がここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相册中导入或扫描照片后，尚未归属伙伴的照片会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
