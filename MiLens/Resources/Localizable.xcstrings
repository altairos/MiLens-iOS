    "onboarding.feature.intro.body %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Fotos, auf denen nur %@ zu sehen ist, aus verschiedenen Winkeln.\nDie gesamte Erkennung läuft vollständig auf deinem Gerät."
