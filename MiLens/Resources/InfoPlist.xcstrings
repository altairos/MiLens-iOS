        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens benötigt Fotozugriff, um Bügelperlen-Muster, Haustierkarten und Zeitleisten zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens needs permission to save bead patterns, pal cards, and timeline export images to your Photos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens enregistre les modèles de perles et les photos que vous exportez dans votre photothèque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLensは、書き出したアイロンビーズ図案や写真を「写真」アプリに保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens 需要保存导出的拼豆图纸和照片到相册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens 需要取得權限，以便將匯出的拼豆圖稿、毛小孩卡片及照片儲存至「照片」圖庫。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens ordnet Haustierfotos lokal. Keine Uploads; Werke können im System-Backup liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens needs access to your photo library to discover photos of your pal and create local profiles. Photos are never uploaded; edited works may be saved by system backups you have enabled."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLens organise vos photos localement, sans envoi. Les créations peuvent suivre vos sauvegardes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiLensは、ペットの写真を見つけて整理するために写真ライブラリへアクセスします。解析はすべて端末上で行い、写真を自動的にアップロードすることはありません。編集した作品は、システムバックアップが有効な場合にバックアップへ含まれることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens 需要访问相册来发现和整理你伙伴的照片。所有分析在本地完成。App 不会主动上传照片；编辑产物可能随用户启用的系统备份保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咪Lens 需要存取相簿，以尋找並整理你毛小孩的照片。所有分析均在本機完成；App 不會主動上傳照片，編輯後的作品可能隨你啟用的系統備份儲存。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
